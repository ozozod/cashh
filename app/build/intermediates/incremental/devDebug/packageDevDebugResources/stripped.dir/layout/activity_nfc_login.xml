<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp" android:gravity="center"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/tvTitle" android:text="@string/login_title"
        android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvStatus" android:text="@string/nfc_ready"
        android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
