<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Texto cuando no hay productos -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay productos"
        tools:visibility="visible"
        android:visibility="gone"
        android:paddingBottom="8dp"/>

    <!-- Contenedor donde inflás/armás las filas de productos -->
    <LinearLayout
        android:id="@+id/productsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_weight="1"
        tools:ignore="NestedWeights" />

    <!-- Total -->
    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: $0.00"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- Botón para escanear y cobrar -->
    <Button
        android:id="@+id/btnScanAndCharge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escanear y cobrar" />
</LinearLayout>
