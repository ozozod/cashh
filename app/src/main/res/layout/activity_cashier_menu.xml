<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/inputAmountFirst"
            android:hint="Monto primera carga"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/btnFirstTopup"
            android:text="Registrar comprador + primera carga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <View android:layout_height="12dp" android:layout_width="match_parent"/>

        <EditText
            android:id="@+id/inputAmountTopup"
            android:hint="Monto cargar saldo"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/btnTopup"
            android:text="Cargar saldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <View android:layout_height="12dp" android:layout_width="match_parent"/>

        <EditText
            android:id="@+id/inputAmountWithdraw"
            android:hint="Monto devolver saldo"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/btnWithdraw"
            android:text="Devolver saldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <View android:layout_height="12dp" android:layout_width="match_parent"/>

        <Button
            android:id="@+id/btnBalance"
            android:text="Consultar saldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <View android:layout_height="20dp" android:layout_width="match_parent"/>

        <Button
            android:id="@+id/btnLogout"
            android:text="Cerrar sesión"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
