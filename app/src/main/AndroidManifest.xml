<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- Requerimos NFC para esta build -->
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.VayVene"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- LAUNCHER (login NFC) -->
        <activity
            android:name=".ui.login.NfcLoginActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Captura de NFC (solo para pedir/leer UID) -->
        <activity
            android:name=".ui.nfc.NfcCaptureActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />

        <!-- Admin -->
        <activity android:name=".ui.admin.AdminMenuActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminCardsMenuActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminStaffRegisterActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminCustomerRegisterActivity" android:exported="false" />

        <!-- Cajero -->
        <activity android:name=".ui.cashier.CashierMenuActivity" android:exported="false" />
        <activity android:name=".ui.cashier.CashierQuickOpsActivity" android:exported="false" />

        <!-- Vendedor -->
        <activity android:name=".ui.seller.SellerMenuActivity" android:exported="false" />
        <activity android:name=".ui.seller.SellerPosActivity" android:exported="false" />
        <activity android:name=".ui.seller.SellerSaleResultActivity" android:exported="false" />
        <activity android:name=".ui.seller.SellerCancelLastSaleActivity" android:exported="false" />
    </application>
</manifest>
